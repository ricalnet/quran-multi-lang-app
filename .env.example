# ============================================================
# Redis
# ============================================================
# REQUIRED. Generate with: openssl rand -hex 32
# Avoid special characters ($, #, !, quotes) to prevent shell
# interpolation issues in podman-compose.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================================
# Resource limits — Web (Next.js)
# ============================================================
# CPU limit (string, supports fractional cores, e.g. "0.5")
WEB_CPU_LIMIT=1.0
# Memory limit (e.g. 512M, 1G)
WEB_MEM_LIMIT=512M
# Max number of processes/threads inside the container
WEB_PIDS_LIMIT=100
# Soft memory reservation (scheduler hint)
WEB_MEM_RESERVATION=256M

# ============================================================
# Resource limits — API (FastAPI)
# ============================================================
API_CPU_LIMIT=1.0
API_MEM_LIMIT=384M
API_PIDS_LIMIT=100
API_MEM_RESERVATION=128M

# ============================================================
# Resource limits — Redis
# ============================================================
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=192M
REDIS_PIDS_LIMIT=50
REDIS_MEM_RESERVATION=64M
# Internal Redis maxmemory (must be lower than REDIS_MEM_LIMIT)
REDIS_MAXMEMORY=128mb

# ============================================================
# tmpfs sizes (writable in-memory mounts for read-only rootfs)
# ============================================================
WEB_TMPFS_TMP=64m
WEB_TMPFS_CACHE=128m
API_TMPFS_TMP=64m
REDIS_TMPFS_TMP=32m
